{
  "name": "astro-animations-demo",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "A lightbox/gallery component for Astro, using content collections, optimised images and modern CSS",
  "author": {
    "name": "StJohn Mackay"
  },
  "license": "MIT",
  "keywords": [
    "astro",
    "astro-component",
    "animation",
    "animations",
    "lightweight",
    "withastro"
  ],
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "format": "biome format --write .",
    "lint": "biome lint --write .",
    "check": "biome check --write .",
    "clean": "rm -rf dist .astro",
    "type-check": "astro check",
    "test": "astro check && biome check src/components src/layouts src/pages src/types *.mjs *.json",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:ui": "pnpm build && playwright test --ui"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.4",
    "@felixicaza/astro-capo": "^1.2.2",
    "@iconify-json/carbon": "^1.2.28",
    "astro": "^7.3.5",
    "astro-animations": "workspace:*",
    "astro-icon": "^1.2.0",
    "open-props": "^1.7.23",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "^1.63.0",
    "postcss-jit-props": "^1.0.16"
  },
  "packageManager": "pnpm@12.10.1+sha512.ba40a37eb1a370d60fea8c4cf1d364c13bcccef518e98ad2bcee954f539d38da37458e58261a3fa55e06523450ea0ffff9f497b135be41f2c15c1642bacace6c"
}
